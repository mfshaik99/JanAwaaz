<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="1200" height="800">
  <defs>
    <!-- Evening / Twilight Dusk Sky -->
    <linearGradient id="duskSky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#090d16"/>
      <stop offset="35%" stop-color="#1e1b4b"/>
      <stop offset="70%" stop-color="#311042"/>
      <stop offset="100%" stop-color="#4a1525"/>
    </linearGradient>

    <!-- Buildings in Night Light -->
    <linearGradient id="buildingNightLeft" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#1e2436"/>
      <stop offset="70%" stop-color="#151b2a"/>
      <stop offset="100%" stop-color="#0d131f"/>
    </linearGradient>
    <linearGradient id="buildingNightRight" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#241829"/>
      <stop offset="60%" stop-color="#1c1322"/>
      <stop offset="100%" stop-color="#110a17"/>
    </linearGradient>

    <!-- Dark Asphalt in Darkness (Before) -->
    <linearGradient id="darkRoadBefore" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#141824"/>
      <stop offset="40%" stop-color="#0d101a"/>
      <stop offset="100%" stop-color="#06080e"/>
    </linearGradient>
    
    <!-- Curb in Night Shadows -->
    <linearGradient id="curbNightTop" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#334155"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
    <linearGradient id="curbNightFace" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>

    <!-- Soft Shadow Filter -->
    <filter id="softShadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000000" flood-opacity="0.4"/>
    </filter>
  </defs>

  <!-- Twilight Sky Background -->
  <rect width="1200" height="800" fill="url(#duskSky)"/>

  <!-- Stars in Night Sky -->
  <g fill="#ffffff" opacity="0.75">
    <circle cx="150" cy="80" r="1.5"/>
    <circle cx="280" cy="50" r="2"/>
    <circle cx="420" cy="90" r="1.5"/>
    <circle cx="560" cy="40" r="2.5"/>
    <circle cx="680" cy="70" r="1.5"/>
    <circle cx="820" cy="55" r="2"/>
    <circle cx="950" cy="85" r="1.5"/>
    <circle cx="1080" cy="60" r="2"/>
    <circle cx="340" cy="120" r="1.5"/>
    <circle cx="750" cy="110" r="1.5"/>
  </g>

  <!-- Glowing Crescent Moon -->
  <g transform="translate(980, 80)">
    <circle cx="30" cy="30" r="32" fill="#fef08a" opacity="0.9" filter="url(#softShadow)"/>
    <circle cx="42" cy="22" r="28" fill="#141824"/>
  </g>

  <!-- Distant Buildings Silhouettes -->
  <g opacity="0.6">
    <rect x="440" y="270" width="100" height="150" rx="4" fill="#0f172a"/>
    <rect x="530" y="250" width="80" height="170" rx="4" fill="#141b2d"/>
    <rect x="600" y="280" width="110" height="140" rx="4" fill="#0f172a"/>
    <!-- Distant window lights -->
    <rect x="460" y="300" width="12" height="16" rx="2" fill="#fef08a" opacity="0.7"/>
    <rect x="550" y="280" width="12" height="16" rx="2" fill="#fef08a" opacity="0.8"/>
  </g>

  <!-- LEFT INDIAN RESIDENTIAL BUILDING -->
  <g id="leftBuilding">
    <!-- Main Facade in Twilight -->
    <path d="M0,230 L320,200 L320,550 L0,570 Z" fill="url(#buildingNightLeft)"/>
    <!-- Side Perspective Wall -->
    <path d="M320,200 L380,215 L380,540 L320,550 Z" fill="#0d121c"/>
    <!-- Parapet Roof -->
    <path d="M-10,225 L325,195 L385,210 L385,225 L320,210 L-10,240 Z" fill="#1e2436"/>
    <!-- Terrace Water Tank -->
    <rect x="180" y="145" width="60" height="52" rx="12" fill="#0f172a"/>
    <rect x="175" y="140" width="70" height="12" rx="4" fill="#1e293b"/>
    
    <!-- Balcony -->
    <rect x="50" y="270" width="90" height="100" rx="8" fill="#090d16"/>
    <!-- Interior Warm Living Room Light shining through window -->
    <rect x="56" y="276" width="78" height="88" rx="6" fill="#fbbf24" opacity="0.85"/>
    <line x1="95" y1="276" x2="95" y2="364" stroke="#78350f" stroke-width="4"/>
    
    <!-- Balcony Slab & Railing -->
    <path d="M35,370 L260,350 L260,380 L35,400 Z" fill="#1e293b"/>
    <!-- Wrought Iron Railings -->
    <g stroke="#090d16" stroke-width="4">
      <line x1="45" y1="350" x2="45" y2="385"/>
      <line x1="85" y1="346" x2="85" y2="381"/>
      <line x1="125" y1="342" x2="125" y2="377"/>
      <line x1="165" y1="338" x2="165" y2="373"/>
      <line x1="205" y1="334" x2="205" y2="369"/>
      <line x1="245" y1="330" x2="245" y2="365"/>
      <line x1="40" y1="345" x2="258" y2="325" stroke-width="5"/>
      <line x1="40" y1="375" x2="258" y2="355" stroke-width="4"/>
    </g>

    <!-- Ground Floor Entry Door & Window -->
    <rect x="140" y="430" width="90" height="120" rx="8" fill="#1e1814"/>
    <!-- Ground floor small window with warm light -->
    <rect x="35" y="435" width="70" height="70" rx="6" fill="#f59e0b" opacity="0.75"/>
    <line x1="70" y1="435" x2="70" y2="505" stroke="#451a03" stroke-width="3"/>
  </g>

  <!-- RIGHT RESIDENTIAL BUILDING & COMPOUND WALL -->
  <g id="rightBuilding">
    <path d="M850,180 L1210,140 L1210,560 L850,580 Z" fill="url(#buildingNightRight)"/>
    <path d="M790,200 L850,180 L850,580 L790,595 Z" fill="#130b17"/>
    <!-- Roof Overhang -->
    <path d="M775,195 L860,175 L1215,135 L1215,150 L855,190 L775,210 Z" fill="#1e1322"/>
    
    <!-- Arched Balcony with Warm Light -->
    <path d="M930,250 Q980,215 1030,250 L1030,350 L930,350 Z" fill="#fde047" opacity="0.8"/>
    <path d="M900,350 L1060,335 L1060,375 L900,390 Z" fill="#2d1d33"/>
    
    <!-- Ground Floor Door & Window -->
    <rect x="880" y="420" width="80" height="140" rx="6" fill="#140c17"/>
    <rect x="1000" y="430" width="80" height="80" rx="6" fill="#f59e0b" opacity="0.6"/>
  </g>

  <!-- NEEM TREE IN DUSK -->
  <g id="trees">
    <path d="M740,510 Q735,390 710,320 Q690,270 670,250 Q710,240 740,270 Q760,210 810,240 Q860,260 850,330 Z" fill="#062413"/>
    <circle cx="730" cy="280" r="55" fill="#07311b"/>
    <circle cx="680" cy="290" r="45" fill="#062413"/>
    <circle cx="780" cy="300" r="50" fill="#07311b"/>
    <path d="M725,330 L745,330 L755,520 L720,520 Z" fill="#190e06"/>
  </g>

  <!-- SIDEWALKS & CURBS (Both Sides) -->
  <g id="sidewalks">
    <!-- Left Sidewalk -->
    <path d="M0,570 L380,540 L440,535 L320,640 L0,700 Z" fill="url(#curbNightTop)"/>
    <path d="M0,700 L320,640 L320,658 L0,720 Z" fill="url(#curbNightFace)"/>

    <!-- Right Sidewalk -->
    <path d="M1200,560 L790,595 L710,535 L820,640 L1200,700 Z" fill="url(#curbNightTop)"/>
    <path d="M820,640 L1200,700 L1200,720 L820,658 Z" fill="url(#curbNightFace)"/>
  </g>

  <!-- ROADWAY IN DARKNESS (BEFORE) -->
  <g id="darkRoad">
    <path d="M320,640 L440,535 L710,535 L820,640 L1200,700 L1200,800 L0,800 L0,700 Z" fill="url(#darkRoadBefore)"/>
    <!-- Faint white center dashes barely visible in pitch dark -->
    <path d="M575,540 L575,560" stroke="#475569" stroke-width="4" opacity="0.3"/>
    <path d="M577,575 L577,605" stroke="#475569" stroke-width="6" opacity="0.3"/>
    <path d="M582,625 L585,670" stroke="#475569" stroke-width="8" opacity="0.3"/>
    <path d="M588,695 L593,760" stroke="#475569" stroke-width="12" opacity="0.3"/>
  </g>

  <!-- ==================== STREETLIGHT POLES (BEFORE: UNLIT / BROKEN) ==================== -->
  <g id="streetlightsBefore">
    <!-- FOREGROUND LEFT STREETLIGHT POLE (Positioned at x=350, y=550) -->
    <!-- Base Plate -->
    <ellipse cx="350" cy="555" rx="14" ry="7" fill="#090d16"/>
    <!-- Main Vertical Curved Steel Pole -->
    <path d="M346,555 L346,260 Q346,160 260,165" fill="none" stroke="#475569" stroke-width="9" stroke-linecap="round"/>
    <path d="M347,555 L347,260 Q347,162 262,166" fill="none" stroke="#64748b" stroke-width="4" stroke-linecap="round"/>
    <!-- Modern Cobra-Head Lamp Fixture (DARK / BROKEN / OFF) -->
    <path d="M265,160 L230,172 L235,186 L270,174 Z" fill="#1e293b" stroke="#0f172a" stroke-width="2"/>
    <!-- Glass lens (Dark, grey, lifeless) -->
    <ellipse cx="248" cy="180" rx="14" ry="5" fill="#0f172a" stroke="#334155" stroke-width="1.5"/>
    
    <!-- MIDGROUND RIGHT STREETLIGHT POLE (Positioned at x=780, y=545) -->
    <ellipse cx="780" cy="550" rx="11" ry="5" fill="#090d16"/>
    <path d="M782,550 L782,310 Q782,230 845,235" fill="none" stroke="#475569" stroke-width="7" stroke-linecap="round"/>
    <path d="M783,550 L783,310 Q783,232 843,236" fill="none" stroke="#64748b" stroke-width="3" stroke-linecap="round"/>
    <!-- Cobra-Head Fixture (DARK / OFF) -->
    <path d="M840,230 L870,240 L865,252 L835,242 Z" fill="#1e293b" stroke="#0f172a" stroke-width="2"/>
    <ellipse cx="852" cy="247" rx="11" ry="4" fill="#0f172a" stroke="#334155" stroke-width="1.5"/>
  </g>

  <!-- HEAVY GLOOMY NIGHT SHADOW OVERLAY (STREET IS DANGEROUSLY DARK) -->
  <rect x="0" y="450" width="1200" height="350" fill="#020617" opacity="0.65"/>
  <path d="M280,500 Q580,480 900,520 L1200,800 L0,800 Z" fill="#000000" opacity="0.4"/>

  <!-- Clear Stylized Status Badge Overlay -->
  <g id="statusBadge" transform="translate(40, 40)">
    <rect x="0" y="0" width="180" height="46" rx="23" fill="#1e293b" opacity="0.9" filter="url(#softShadow)"/>
    <circle cx="24" cy="23" r="10" fill="#ef4444"/>
    <text x="46" y="29" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-weight="800" font-size="16" letter-spacing="1.5">BEFORE</text>
  </g>
</svg>
