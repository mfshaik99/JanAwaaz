<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="1200" height="800">
  <defs>
    <!-- Sky & Atmosphere -->
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4ea8de"/>
      <stop offset="60%" stop-color="#90e0ef"/>
      <stop offset="100%" stop-color="#caf0f8"/>
    </linearGradient>
    <radialGradient id="sunGlow" cx="20%" cy="15%" r="35%">
      <stop offset="0%" stop-color="#fffbeb" stop-opacity="1"/>
      <stop offset="30%" stop-color="#fde047" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#fde047" stop-opacity="0"/>
    </radialGradient>

    <!-- 3D Building Palettes -->
    <linearGradient id="wallOchre" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#fef3c7"/>
      <stop offset="60%" stop-color="#fde68a"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>
    <linearGradient id="wallOchreShadow" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f59e0b"/>
      <stop offset="100%" stop-color="#d97706"/>
    </linearGradient>
    <linearGradient id="wallCoral" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#fca5a5"/>
      <stop offset="70%" stop-color="#f87171"/>
      <stop offset="100%" stop-color="#ef4444"/>
    </linearGradient>
    <linearGradient id="terracottaRoof" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#fb923c"/>
      <stop offset="100%" stop-color="#c2410c"/>
    </linearGradient>
    
    <!-- 3D Curb & Sidewalk -->
    <linearGradient id="curbTop" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#e2e8f0"/>
      <stop offset="100%" stop-color="#cbd5e1"/>
    </linearGradient>
    <linearGradient id="curbFace" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#94a3b8"/>
      <stop offset="100%" stop-color="#64748b"/>
    </linearGradient>

    <!-- Damaged Asphalt Gradients -->
    <linearGradient id="roadSurfaceDamaged" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#475569"/>
      <stop offset="40%" stop-color="#334155"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
    
    <!-- Pothole Inner Depth Gradients -->
    <radialGradient id="potholeDepth1" cx="45%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#090d16"/>
      <stop offset="65%" stop-color="#0f172a"/>
      <stop offset="85%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#334155"/>
    </radialGradient>
    <radialGradient id="potholeDepth2" cx="50%" cy="45%" r="60%">
      <stop offset="0%" stop-color="#020617"/>
      <stop offset="70%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#334155"/>
    </radialGradient>
    <linearGradient id="mudPuddle" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b2d1f"/>
      <stop offset="50%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.6"/>
    </linearGradient>

    <!-- Foliage Gradients -->
    <linearGradient id="treeGreen1" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4ade80"/>
      <stop offset="70%" stop-color="#16a34a"/>
      <stop offset="100%" stop-color="#14532d"/>
    </linearGradient>
    <linearGradient id="treeGreen2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#86efac"/>
      <stop offset="70%" stop-color="#22c55e"/>
      <stop offset="100%" stop-color="#15803d"/>
    </linearGradient>
    
    <!-- Soft Shadows -->
    <filter id="softShadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#0f172a" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Sky Background -->
  <rect width="1200" height="800" fill="url(#skyGrad)"/>
  <circle cx="240" cy="110" r="160" fill="url(#sunGlow)"/>
  
  <!-- Stylized 3D Cartoon Clouds -->
  <g fill="#ffffff" opacity="0.9" filter="url(#softShadow)">
    <circle cx="160" cy="120" r="45"/>
    <circle cx="210" cy="105" r="55"/>
    <circle cx="265" cy="115" r="40"/>
    <circle cx="310" cy="125" r="30"/>
    <rect x="150" y="125" width="160" height="35" rx="15"/>
    
    <circle cx="850" cy="90" r="40"/>
    <circle cx="900" cy="75" r="55"/>
    <circle cx="950" cy="85" r="45"/>
    <rect x="840" y="95" width="120" height="30" rx="15"/>
  </g>

  <!-- Distant Background Indian Buildings -->
  <g opacity="0.85">
    <rect x="420" y="240" width="110" height="150" rx="6" fill="#fed7aa"/>
    <rect x="520" y="220" width="90" height="170" rx="6" fill="#e2e8f0"/>
    <rect x="600" y="250" width="130" height="140" rx="6" fill="#fef08a"/>
    <!-- Water tank on distant building -->
    <rect x="445" y="215" width="36" height="25" rx="5" fill="#1e293b"/>
    <rect x="540" y="195" width="32" height="25" rx="5" fill="#0284c7"/>
  </g>

  <!-- LEFT INDIAN RESIDENTIAL BUILDING (Hyderabad Style 3D) -->
  <g id="leftBuilding">
    <!-- Main Wall Front Face -->
    <path d="M0,230 L320,200 L320,530 L0,550 Z" fill="url(#wallOchre)"/>
    <!-- Side Extrusion / Perspective -->
    <path d="M320,200 L380,215 L380,520 L320,530 Z" fill="url(#wallOchreShadow)"/>
    <!-- Roof Parapet & Terrace -->
    <path d="M-10,225 L325,195 L385,210 L385,225 L320,210 L-10,240 Z" fill="#b45309"/>
    <!-- Terrace Water Tank (Sintex Style) -->
    <rect x="180" y="145" width="60" height="52" rx="12" fill="#0284c7"/>
    <rect x="175" y="140" width="70" height="12" rx="4" fill="#0369a1"/>
    <line x1="180" y1="165" x2="240" y2="165" stroke="#0369a1" stroke-width="3"/>
    <line x1="180" y1="180" x2="240" y2="180" stroke="#0369a1" stroke-width="3"/>
    
    <!-- 2nd Floor Balcony with Wrought Iron Railings -->
    <rect x="50" y="270" width="200" height="110" rx="10" fill="#0284c7" opacity="0.15"/>
    <rect x="50" y="270" width="90" height="100" rx="8" fill="#1e293b"/>
    <rect x="56" y="276" width="78" height="88" rx="6" fill="#38bdf8"/>
    <line x1="95" y1="276" x2="95" y2="364" stroke="#0284c7" stroke-width="4"/>
    
    <!-- Balcony Slab & Railing -->
    <path d="M35,370 L260,350 L260,380 L35,400 Z" fill="#cbd5e1"/>
    <path d="M35,400 L260,380 L260,390 L35,410 Z" fill="#94a3b8"/>
    <!-- Wrought Iron Railing Pillars -->
    <g stroke="#1e293b" stroke-width="4">
      <line x1="45" y1="350" x2="45" y2="385"/>
      <line x1="75" y1="347" x2="75" y2="382"/>
      <line x1="105" y1="344" x2="105" y2="379"/>
      <line x1="135" y1="341" x2="135" y2="376"/>
      <line x1="165" y1="338" x2="165" y2="373"/>
      <line x1="195" y1="335" x2="195" y2="370"/>
      <line x1="225" y1="332" x2="225" y2="367"/>
      <line x1="255" y1="329" x2="255" y2="364"/>
      <!-- Top and bottom horizontal rail -->
      <line x1="40" y1="345" x2="258" y2="325" stroke-width="5"/>
      <line x1="40" y1="375" x2="258" y2="355" stroke-width="4"/>
    </g>

    <!-- Ground Floor Gate & Door -->
    <rect x="140" y="420" width="90" height="110" rx="8" fill="#78350f"/>
    <rect x="148" y="428" width="74" height="102" rx="4" fill="#92400e"/>
    <circle cx="210" cy="480" r="5" fill="#fde047"/>
    <!-- Window with sunshade chhajja -->
    <path d="M30,410 L110,402 L120,418 L20,426 Z" fill="#b45309"/>
    <rect x="35" y="425" width="70" height="70" rx="6" fill="#38bdf8"/>
    <line x1="70" y1="425" x2="70" y2="495" stroke="#ffffff" stroke-width="3"/>
  </g>

  <!-- RIGHT INDIAN RESIDENTIAL BUILDING & GARDEN WALL -->
  <g id="rightBuilding">
    <!-- Main Right Building Face -->
    <path d="M850,180 L1210,140 L1210,540 L850,560 Z" fill="url(#wallCoral)"/>
    <!-- Left Perspective Face -->
    <path d="M790,200 L850,180 L850,560 L790,575 Z" fill="#dc2626"/>
    <!-- Terracotta roof overhang -->
    <path d="M775,195 L860,175 L1215,135 L1215,150 L855,190 L775,210 Z" fill="url(#terracottaRoof)"/>
    
    <!-- Decorative arched balcony -->
    <path d="M920,240 Q980,200 1040,240 L1040,360 L920,360 Z" fill="#ffffff"/>
    <path d="M930,250 Q980,215 1030,250 L1030,350 L930,350 Z" fill="#0284c7"/>
    <path d="M900,350 L1060,335 L1060,375 L900,390 Z" fill="#fed7aa"/>
    
    <!-- Ground Floor Entry & Windows -->
    <rect x="880" y="410" width="80" height="130" rx="6" fill="#451a03"/>
    <rect x="1000" y="420" width="80" height="80" rx="6" fill="#bae6fd"/>
    <line x1="1040" y1="420" x2="1040" y2="500" stroke="#0284c7" stroke-width="4"/>
  </g>

  <!-- LUSH TREES (Left & Right) -->
  <g id="trees">
    <!-- Right Neem Tree behind building/wall -->
    <path d="M740,490 Q735,380 710,310 Q690,260 670,240 Q710,230 740,260 Q760,200 810,230 Q860,250 850,320 Z" fill="url(#treeGreen1)"/>
    <circle cx="730" cy="270" r="55" fill="url(#treeGreen2)"/>
    <circle cx="680" cy="280" r="45" fill="url(#treeGreen1)"/>
    <circle cx="780" cy="290" r="50" fill="url(#treeGreen2)"/>
    <!-- Tree Trunk -->
    <path d="M725,320 L745,320 L755,500 L720,500 Z" fill="#78350f"/>

    <!-- Left Flowering Bush / Bougainvillea -->
    <circle cx="340" cy="460" r="40" fill="url(#treeGreen2)"/>
    <circle cx="370" cy="480" r="35" fill="url(#treeGreen1)"/>
    <circle cx="330" cy="490" r="30" fill="url(#treeGreen2)"/>
    <circle cx="345" cy="455" r="8" fill="#f43f5e"/>
    <circle cx="365" cy="470" r="7" fill="#f43f5e"/>
    <circle cx="330" cy="485" r="6" fill="#f43f5e"/>
    <circle cx="375" cy="495" r="8" fill="#f43f5e"/>
  </g>

  <!-- ELECTRIC UTILITY POLE & WIRES (Standard Indian Neighborhood) -->
  <g id="utilityPole">
    <!-- Main Concrete Post -->
    <path d="M385,210 L397,210 L405,530 L380,530 Z" fill="#cbd5e1"/>
    <!-- Crossbar -->
    <rect x="360" y="240" width="65" height="10" rx="3" fill="#64748b"/>
    <!-- Insulators -->
    <rect x="365" y="232" width="8" height="10" rx="2" fill="#0284c7"/>
    <rect x="388" y="232" width="8" height="10" rx="2" fill="#0284c7"/>
    <rect x="412" y="232" width="8" height="10" rx="2" fill="#0284c7"/>
    <!-- Power Lines sweeping in 3D perspective -->
    <path d="M369,235 Q600,280 820,250" fill="none" stroke="#334155" stroke-width="2.5" opacity="0.75"/>
    <path d="M392,235 Q620,290 850,260" fill="none" stroke="#334155" stroke-width="2" opacity="0.75"/>
    <path d="M416,235 Q640,295 880,268" fill="none" stroke="#334155" stroke-width="2.5" opacity="0.75"/>
  </g>

  <!-- SIDEWALKS & CURBS (Both Sides) -->
  <g id="sidewalks">
    <!-- Left Sidewalk Top Surface -->
    <path d="M0,550 L380,520 L440,515 L320,620 L0,680 Z" fill="url(#curbTop)"/>
    <!-- Left Curb Front Vertical Lip -->
    <path d="M0,680 L320,620 L320,638 L0,700 Z" fill="url(#curbFace)"/>

    <!-- Right Sidewalk Top Surface -->
    <path d="M1200,540 L790,575 L710,515 L820,620 L1200,680 Z" fill="url(#curbTop)"/>
    <!-- Right Curb Front Vertical Lip -->
    <path d="M820,620 L1200,680 L1200,700 L820,638 Z" fill="url(#curbFace)"/>
  </g>

  <!-- ==================== DAMAGED ROAD SURFACE (BEFORE) ==================== -->
  <g id="roadSurface">
    <!-- Main Road Base Canvas -->
    <path d="M320,620 L440,515 L710,515 L820,620 L1200,680 L1200,800 L0,800 L0,680 Z" fill="url(#roadSurfaceDamaged)"/>

    <!-- Distressed Weathered Patches & Texture -->
    <path d="M400,550 Q560,530 680,550 L660,570 Q540,545 410,565 Z" fill="#1e293b" opacity="0.6"/>
    <path d="M480,680 Q620,660 800,690 L780,720 Q610,680 460,705 Z" fill="#1e293b" opacity="0.7"/>

    <!-- Faded / Broken Center Line -->
    <path d="M570,520 L575,550" stroke="#fef08a" stroke-width="6" stroke-linecap="round" opacity="0.4"/>
    <path d="M578,575 L585,605" stroke="#fef08a" stroke-width="7" stroke-linecap="round" opacity="0.3"/>
    <!-- Missing center marking due to erosion -->
    
    <!-- POTHOLE 1: Massive Center Pothole with Broken Asphalt Crust -->
    <!-- Broken asphalt outer rim -->
    <path d="M490,620 C520,605 600,600 660,615 C710,630 730,660 690,685 C650,705 560,715 500,695 C450,675 460,635 490,620 Z" fill="#0f172a" stroke="#64748b" stroke-width="4"/>
    <!-- Deep Crater Interior -->
    <path d="M505,628 C530,615 590,610 645,622 C690,635 710,655 675,675 C640,692 570,702 520,685 C480,670 485,640 505,628 Z" fill="url(#potholeDepth1)"/>
    <!-- Dirty stagnant rainwater puddle inside crater -->
    <ellipse cx="585" cy="655" rx="75" ry="24" fill="url(#mudPuddle)"/>
    <!-- Broken asphalt jagged debris / chunks inside -->
    <polygon points="530,645 545,635 555,648 535,655" fill="#475569" stroke="#0f172a" stroke-width="2"/>
    <polygon points="630,650 655,640 665,658 640,665" fill="#334155" stroke="#0f172a" stroke-width="2"/>
    <polygon points="575,670 595,665 605,680 580,685" fill="#475569" stroke="#0f172a" stroke-width="2"/>
    <!-- Radiating Spiderweb Cracks from Pothole 1 -->
    <path d="M490,620 L440,605 L410,615 L370,595" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>
    <path d="M440,605 L430,580 L400,570" stroke="#0f172a" stroke-width="3" stroke-linecap="round" fill="none"/>
    <path d="M660,615 L710,595 L750,605 L800,585" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>
    <path d="M710,595 L735,570 L770,565" stroke="#0f172a" stroke-width="2.5" stroke-linecap="round" fill="none"/>
    <path d="M500,695 L460,730 L410,750 L350,775" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
    <path d="M460,730 L485,760 L470,795" stroke="#0f172a" stroke-width="3" stroke-linecap="round" fill="none"/>
    <path d="M690,685 L745,710 L810,730 L870,760" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>

    <!-- POTHOLE 2: Foreground Deep Pothole (Left side) -->
    <path d="M220,700 C250,685 320,685 360,705 C400,725 390,755 350,775 C310,795 240,790 200,765 C170,740 190,715 220,700 Z" fill="#0f172a" stroke="#64748b" stroke-width="4"/>
    <path d="M230,710 C255,698 310,698 345,715 C375,730 370,750 335,765 C300,780 245,778 215,758 C195,738 210,720 230,710 Z" fill="url(#potholeDepth2)"/>
    <ellipse cx="285" cy="740" rx="55" ry="18" fill="url(#mudPuddle)"/>
    <!-- Loose stones around hole -->
    <circle cx="175" cy="710" r="6" fill="#64748b" stroke="#1e293b" stroke-width="2"/>
    <circle cx="190" cy="695" r="4" fill="#94a3b8"/>
    <circle cx="380" cy="780" r="7" fill="#475569" stroke="#1e293b" stroke-width="2"/>
    <circle cx="400" cy="765" r="5" fill="#64748b"/>

    <!-- POTHOLE 3: Mid-distance Pothole (Right side) -->
    <path d="M720,545 C740,538 780,538 800,550 C820,562 810,578 790,588 C770,598 730,595 710,582 C695,570 705,552 720,545 Z" fill="#0f172a" stroke="#475569" stroke-width="3"/>
    <ellipse cx="755" cy="565" rx="35" ry="14" fill="#090d16"/>
    <!-- Deep crack splitting to right curb -->
    <path d="M800,550 L845,555 L890,545" stroke="#090d16" stroke-width="3.5" stroke-linecap="round" fill="none"/>
  </g>

  <!-- Clear Stylized Status Badge Overlay -->
  <g id="statusBadge" transform="translate(40, 40)">
    <rect x="0" y="0" width="180" height="46" rx="23" fill="#1e293b" opacity="0.9" filter="url(#softShadow)"/>
    <circle cx="24" cy="23" r="10" fill="#ef4444"/>
    <text x="46" y="29" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-weight="800" font-size="16" letter-spacing="1.5">BEFORE</text>
  </g>
</svg>
